# --- Database ---
DATABASE_URL=postgres://sellman:sellman@localhost:5432/sellman

# --- Taskman brain (read-only) ---
TASKMAN_BRAIN_URL=https://taskman.internal.example
TASKMAN_BRAIN_TOKEN=
# Bootstrap without Taskman: point to a local manifest instead of the URL
# TASKMAN_BRAIN_FILE=config/brain.example.json
MIN_PROOF_SAMPLE=5

# --- AI routing (ordered fallback, provider:model) ---
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
SELLMAN_MODELS_FAST=anthropic:claude-haiku-4-5-20251001,openai_compat:llama-3.3-70b-versatile
SELLMAN_MODELS_DEEP=anthropic:claude-sonnet-5,anthropic:claude-opus-5
# Anthropic server-side web search tool type (check current docs)
SELLMAN_WEB_SEARCH_TOOL=web_search_20250305

# --- Outbound (off by default) ---
SELLMAN_OUTBOUND_ENABLED=false
SELLMAN_MAIL_TRANSPORT=log            # log | resend
RESEND_API_KEY=
SELLMAN_SENDER_NAME=
SELLMAN_SENDER_EMAIL=
SELLMAN_POSTAL_ADDRESS=
SELLMAN_UNSUBSCRIBE_BASE_URL=https://example.com/u
SELLMAN_DAILY_SEND_CAP=30

# --- Crawling ---
SELLMAN_USER_AGENT=SellmanBot/0.1 (+https://example.com/bot)

# --- Web surface (events, unsubscribe, deliverability webhooks) ---
PORT=8787
SELLMAN_UNSUBSCRIBE_SECRET=

# --- Reporting ---
SELLMAN_OPERATOR_EMAIL=
